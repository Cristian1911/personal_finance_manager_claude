{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1027538281655-dveo3pn7m1s9es0lsjkmuat4u536lpgh.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1027538281655-dh3so5rl229inv5djocenpdh546pij7o.apps.googleusercontent.com"
      }
    },
    "preview-local": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000"
      }
    },
    "preview-device": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm.sanson1911.cloud"
      }
    },
    "preview-ios-simulator-local": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3000"
      }
    },
    "preview-ios-simulator-device": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm.sanson1911.cloud"
      }
    },
    "preview-ios-device": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm.sanson1911.cloud"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1027538281655-dveo3pn7m1s9es0lsjkmuat4u536lpgh.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1027538281655-dh3so5rl229inv5djocenpdh546pij7o.apps.googleusercontent.com"
      }
    },
    "production-android": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm.sanson1911.cloud"
      }
    },
    "production-ios": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm.sanson1911.cloud"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "venti5.labs@gmail.com",
        "ascAppId": "6763683831",
        "appleTeamId": "F5GQBU5JPS"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "alpha"
      }
    },
    "production-ios": {
      "extends": "production"
    },
    "production-android": {
      "extends": "production"
    }
  }
}
